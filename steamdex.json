{
  "parsers": [
    {
      "name": "Sample ROM Library",
      "enabled": true,
      "title_from": "root_child_directory",
      "directories": ["test-data/sample-library-rom"],
      "globs": ["*.rom"]
    },
    {
      "name": "Sample EXE Library",
      "enabled": false,
      "title_from": "root_child_directory",
      "directories": ["test-data/sample-library-exe"],
      "globs": ["*.exe"]
    },
    {
      "name": "Sample Combined ROM and EXE Library",
      "enabled": false,
      "title_from": "root_child_directory",
      "directories": [
        "test-data/sample-library-rom",
        "test-data/sample-library-exe"
      ],
      "globs": ["*.rom", "*.exe"]
    },
    {
      "name": "Sample Combined ROM and EXE Library With Errors",
      "enabled": false,
      "title_from": "root_child_directory",
      "directories": [
        "test-data/sample-library-rom",
        "test-data/sample-library-exe",
        "test-data/missing-library-for-error-test",
        "test-data/sample-library-rom/notes.txt"
      ],
      "globs": ["*.rom", "*.exe"]
    },
    {
      "name": "Sample Switch Library with Real Game Titles",
      "enabled": false,
      "title_from": "root_child_directory",
      "directories": ["test-data/sample-library-switch"],
      "globs": ["*.nsp", "*.xci"]
    },
    {
      "name": "Sample PC Bottles Library with Real Game Titles",
      "enabled": false,
      "title_from": "root_child_directory",
      "directories": ["test-data/sample-library-bottles"],
      "globs": ["my.launcher.bat"]
    }
  ]
}
